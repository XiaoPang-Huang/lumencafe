# 本地开发环境变量模板（复制为 .env 使用；.env 不入库）
# 环境基线见 docs/白皮书-v3.md §02

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lumencafe
STORAGE_DRIVER=local

# 主程序端口（src/server.mjs 读取）
PORT=8480

# DeepSeek 官方 API（可选；主程序首启时种子成「模型 & API 管理」的供应商）
DEEPSEEK_API_KEY=

# 模型密钥加密主密钥（需求-模型API管理-v1.md R1；≥16 字符，生产必配随机长串）
# 泄漏 = 全部入库密钥可被解密，按密钥同等保护
LC_SECRET_KEY=
