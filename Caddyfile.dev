# 本地开发用 Caddy：纯 IP 访问，不用域名（2026-10-25 拍板）
# :80 通配所有 Host——本机 http://127.0.0.1、局域网 http://<本机IP>（手机调试）都进得来
# SSE 反代关键：flush_interval -1 关闭缓冲
:80 {
	# 与生产语义对齐：/api/* 剥前缀反代（api.js 本地直连 :8000 不走这里；
	# 本机经 127.0.0.1 验收 /api/* 时与生产一致）
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	reverse_proxy api:8000 {
		flush_interval -1
	}
}

# Uptime Kuma 监控台（底座步 5）：本地直 HTTP（局域网可访，免自签告警）；
# 生产为根目录 Caddyfile :8444（自签 HTTPS，同主站模式）。Kuma 自带登录，仅管理面。
:8444 {
	reverse_proxy kuma:3001
}
