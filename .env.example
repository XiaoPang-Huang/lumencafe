# ===== 后端配置（前缀 LUMEN_，与 backend/.env.example 保持一致）=====
LUMEN_DATABASE_URL=postgresql+asyncpg://lumencafe:lumencafe@db:5432/lumencafe
LUMEN_JWT_SECRET=please-change-me-to-a-long-random-string
LUMEN_JWT_EXPIRE_DAYS=30

# 连接池（2核4G 小池；与 PG max_connections=20 匹配）
LUMEN_DB_POOL_SIZE=5
LUMEN_DB_MAX_OVERFLOW=10

# CORS（本地开发；生产由 Caddy 同域反代，可留空）
LUMEN_CORS_ORIGINS=http://localhost:5173

LUMEN_LOG_LEVEL=INFO

# 内部任务令牌：n8n 调 /internal/jobs/* 用（X-Internal-Token 头）；
# 工作流 JSON 里引用 $env.LUMEN_INTERNAL_TOKEN，由 compose 注入 n8n 容器
LUMEN_INTERNAL_TOKEN=please-change-me-to-a-long-random-string

# ===== docker compose 使用（不带前缀）=====
# 注意：compose 会对 .env 值做 $ 变量插值（实测 v5.5.1：双引号不防插值，单引号才防）。
# 密码含 $ 等特殊字符时用单引号包裹或 $$ 转义，如：
#   POSTGRES_PASSWORD='a@b#c$d'    或    POSTGRES_PASSWORD=a@b#c$$d
# 同时别忘了 LUMEN_DATABASE_URL 里的密码要做 URL 编码（@→%40、#→%23、$→%24）
POSTGRES_PASSWORD=lumencafe

# ===== n8n 自动化编排（可选组件；不直连数据库，仅通过 HTTP 调 API）=====
# Basic Auth 是 n8n 直连端口（http://IP:5678）的唯一门槛，生产必须改掉默认值
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
# 本地开发用 localhost；服务器 IP 直连模式填 134.175.114.81
# （n8n 不经 Caddy，直接 http://IP:5678 访问，prod 覆盖层已配好 http + 非 Secure Cookie）
N8N_HOST=localhost
# n8n 凭据加密密钥：openssl rand -hex 32 生成；不设则存进 n8n_data 卷，
# 卷丢了=所有第三方凭据作废，生产建议显式设置并离线备份
N8N_ENCRYPTION_KEY=

# ===== DNSPod API 令牌（域名未备案时签证书用；备案后可删）=====
# 申请：DNSPod 控制台 → 用户中心 → API 令牌 → 创建（需读写 DNS 记录权限）
# 格式：整行一个值，「令牌ID,令牌Key」，例如 1234567,a1b2c3d4e5f6...
# 作用：Caddy 经 DNSPod API 自动添加 _acme-challenge TXT 记录完成域名验证，
# 不依赖 80/443 入站端口（未备案域名这两端口被腾讯云拦截，LE 也无法验证）。
# 不配则 Caddyfile 的 dns_tls 取到空值，证书签发失败（本地开发不需要）
DNSPOD_TOKEN=

# ===== Hatchet 定时引擎（论文域步 B；可选组件，不配则定时抓取退化到 /internal/jobs）=====
# 控制台初始管理员（首启初始化 hatchet 库时种子；生产必须改掉默认值；
# 密码要求 8-64 位、含大小写字母和数字）
HATCHET_ADMIN_EMAIL=admin@example.com
HATCHET_ADMIN_PASSWORD=Admin123!!
# 后端 worker 接入引擎的 API token：首次启动引擎后，管理员登录控制台
# （/admin/hatchet）→ Settings → API Tokens 生成，填到这里并重启 api。
# 留空 = 后端不接线 Hatchet（pipeline.start() 惰性跳过，其余功能不受影响）
HATCHET_CLIENT_TOKEN=
# SDK 连引擎 gRPC 的 TLS 策略：compose 内网明文固定 none（引擎 SERVER_GRPC_INSECURE=t 对应）；
# 若将来引擎启用 TLS，这里改 default 并配置证书
HATCHET_CLIENT_TLS_STRATEGY=none
# 引擎对外 URL（控制台子路径反代地址；服务器 IP 直连模式填
# https://<IP>:8443/admin/hatchet）。仅影响控制台跳转/回调，不影响 worker 接入
HATCHET_SERVER_URL=http://127.0.0.1/admin/hatchet

# ===== 备份（底座步 4）=====
# restic 仓库加密口令：长随机串（openssl rand -hex 32 生成）；丢失 = 备份不可恢复。
# 不配则 compose 拒绝启动 backup 服务（显式失败，不静默跳过备份）
RESTIC_PASSWORD=
# 备份仓库宿主机落盘路径（本机拍板 E:/backups/lumencafe-restic；
# 服务器部署改 Linux 路径，如 /srv/backups/lumencafe-restic；缺省 ./backups/restic）
BACKUP_REPO_HOST_PATH=
