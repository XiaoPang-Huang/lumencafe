# 流光咖啡馆 Caddy 配置（服务器用；本地开发用 Caddyfile.dev）
# SSE 反代关键：flush_interval -1 关闭缓冲，流式输出不卡
# 前置条件：deploy/docker-compose.prod.yml 把 ./prototype/v2 挂进 caddy 容器的 /srv/frontend
#
# ============ IP 直连模式（2026-10-18 启用，不使用域名）============
# 背景：域名未做 ICP 备案，腾讯云拦截该域名的 80/443（公网连接被 RST，
# Let's Encrypt 也无法完成验证），故放弃域名、全程 IP 直连。
# IP 地址不携带域名信息，不在备案拦截范围内。
#
# 访问地址：
#   https://134.175.114.81:8443    保底地址（8443 必然不被拦截）
#   https://134.175.114.81         若腾讯云不拦「IP 直连的 443」则可用（先试这个）
#   http://134.175.114.81          80 端口自动跳 8443
# 首次打开浏览器提示「证书不受信任」：点 高级 → 继续访问。
# 证书由 Caddy 内部 CA 自签：加密有效、无 CA 背书。
# on_demand 必须保留——实测去掉后 IP 直连（无 SNI）无法完成握手。
#
# 恢复域名模式（DNS-01，无需备案、浏览器绿标、自动续期）：
#   ① cp deploy/Caddyfile.domain Caddyfile
#   ② docker-compose.yml 的 caddy 恢复 build: ./deploy/caddy（见该处注释）
#   ③ .env 配 DNSPOD_TOKEN（DNSPod 控制台 → API 令牌，格式「ID,Key」）
#   ④ docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build
# 或做 ICP 备案后切回标准端口（无端口网址）。详见 docs/部署指南-v1.md §1.1。

# IP 站点：443 + 8443 双端口监听，内容相同（哪个不被拦截就用哪个）
:443, :8443 {
	# 内部 CA 自签证书；on_demand 现场签发（IP 无 SNI 也能握手，已验证）
	tls internal {
		on_demand
	}

	# 主站：前端静态站 + 同域反代 /api/*（assets/js/api.js 生产模式走此前缀，IP 访问同样同源）
	root * /srv/frontend
	file_server

	# handle_path 会剥掉 /api 前缀再转发（/api/auth/login → /auth/login）
	# 注意：只代理 /api/*，/internal/* 不会到达 api 容器（落到 file_server 404），内网接口不暴露
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
}

# HTTP（80）统一跳 HTTPS 的 8443（保底端口）
:80 {
	redir https://{host}:8443{uri} permanent
}

# Uptime Kuma 监控台（底座步 5，2026-10-25 拍板）。
# 背景：v2.6 原拟 /admin/status 子路径，实测 Kuma 前端资源全绝对路径 + 服务端无
# base-path 支持，子路径不可行（证据见依赖锁定清单 §5.4）；修订为独立端口，
# 暴露面与主站同级（IP 直连模式），Kuma 自带登录、仅作管理面。
# Kuma 容器不发布宿主机端口，唯一入口即此。
:8444 {
	# 与主站同模式：内部 CA 自签证书，on_demand 保证 IP 无 SNI 可握手
	tls internal {
		on_demand
	}
	reverse_proxy kuma:3001
}
