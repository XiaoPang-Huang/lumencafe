# 环境与密钥（任何 .env 都不入库，示例文件除外）
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / 前端
node_modules/
dist/
*.local

# 系统与工具
.DS_Store
.idea/
.vscode/
.workbuddy/

# 旧版后端（仅本地参考，不入库）
old/

# 数据与备份
*.dump
*.sql.gz
backups/

# Skill 文件夹库（技能包为运行期数据，不入库；保留目录占位）
skills/*
!skills/.gitkeep

# n8n 中文界面包（体积大，不入库；服务器上跑 deploy/n8n-zh-setup.sh 自动下载解压）
n8n-zh/
