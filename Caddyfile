# 流光咖啡馆 Caddy 配置（服务器用；本地开发用 Caddyfile.dev）
# SSE 反代关键：flush_interval -1 关闭缓冲，流式输出不卡
# 前置条件：deploy/docker-compose.prod.yml 把 ./prototype/v2 挂进 caddy 容器的 /srv/frontend
#
# ⚠️ 当前为临时端口方案（2026-10-18）：域名 lumenhub.online 未做 ICP 备案，
# 腾讯云拦截未备案域名的 80/443（公网连接被 RST，Let's Encrypt 无法验证）。
# 备案通过后恢复标准端口：删掉各处 ":8443" 和下面第 9 行的注释说明即可，
# Caddy 会自动改走 80/443 并重新签发证书（访问地址随之变回不带端口）。
# 8443 不在备案拦截范围（拦截只针对 80/443），证书用 TLS-ALPN 在 8443 上验证。

# 通用安全响应头（所有站点复用）
(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
		-Server
	}
}

# 主站：前端静态站 + 同域反代 /api/*（assets/js/api.js 生产模式走此前缀）
cafe.lumenhub.online:8443 {
	import common_headers
	root * /srv/frontend
	file_server

	# handle_path 会剥掉 /api 前缀再转发（/api/auth/login → /auth/login）
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
}

# API 子域：供外部客户端（OpenAI 兼容 /gw/v1、移动端）直连
# /internal/* 只允许 compose 内网调用（n8n → http://api:8000），公网一律 404
api.lumenhub.online:8443 {
	import common_headers
	route {
		@internal path /internal/*
		respond @internal 404
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
}

# n8n 编排控制台（可选）：n8n 2.x 首次打开要自建 owner 账号；
# 域名需与 compose 里 N8N_HOST 一致，否则 webhook URL 会错
n8n.lumenhub.online:8443 {
	import common_headers
	reverse_proxy n8n:5678
}

# 备用域名统一跳主站（DNS 里已有的 apex / www 记录，避免无证书报错）
lumenhub.online:8443, www.lumenhub.online:8443, www.cafe.lumenhub.online:8443, www.api.lumenhub.online:8443 {
	import common_headers
	redir https://cafe.lumenhub.online:8443{uri} permanent
}
