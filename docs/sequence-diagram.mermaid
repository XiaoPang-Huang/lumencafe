%% 流光咖啡馆 批次1 时序图：登录鉴权 + /chat SSE 全流程
%% 对应《架构设计-v1.md》第 5 节

sequenceDiagram
    autonumber
    participant C as 客户端
    participant R as routers/auth.py
    participant S as security.py
    participant D as PostgreSQL

    C->>R: POST /auth/login {username, password}
    R->>D: SELECT user WHERE username=?
    D-->>R: user(含 password_hash, is_active, is_deleted)
    R->>S: verify_password(plain, hash)
    S-->>R: True
    R->>D: SELECT roles via user_roles
    R->>S: create_token(sub=user.id, exp=30d)
    S-->>R: JWT
    R-->>C: {token, user:{id, username, nickname, roles}}

    Note over C,D: 后续请求
    C->>R: GET /admin/models/providers<br/>Authorization: Bearer <JWT>
    R->>S: decode_token()
    S-->>R: user_id
    R->>D: get_current_user → user(is_active? is_deleted?)
    R->>D: require_permission("admin:models")<br/>user_roles → role_permissions → codes
    D-->>R: {"admin:users","admin:models",...}
    alt 含 admin:models
        R-->>C: 200 + 数据
    else 不含
        R-->>C: 403 {"detail":"权限不足"}
    end

sequenceDiagram
    autonumber
    participant C as 客户端(ChatApp)
    participant R as routers/chat.py
    participant B as binding_service
    participant G as llm_gateway
    participant D as PostgreSQL
    participant L as LLM Provider

    C->>R: POST /chat {app_id, conversation_id?, message}
    R->>D: require_permission(registry.perm_code)<br/>+ 取 app_bindings
    alt 无绑定 / provider 停用
        R-->>C: 503 {"detail":"该应用尚未配置模型，请联系管理员"}
    end
    R->>D: 会话解析：校验归属 / 用最近会话 / 新建
    R->>D: 首条消息? → title = message[:16]
    R->>D: INSERT chat_messages(user消息) + 会话 updated_at
    R->>D: load_context 最近 20 轮(40条)
    R->>B: resolve(app_id) → (provider, model, 参数合并)
    B-->>R: OpenAICompatibleClient(base_url, key, model, params)
    R-->>C: 200 text/event-stream

    loop 流式
        R->>G: chat_stream(messages=[system]+history)
        G->>L: POST /chat/completions (stream=true)
        L-->>G: SSE chunks
        G-->>R: delta
        R-->>C: data: {"delta": "..."}
    end

    alt 流正常结束
        R->>D: 独立会话 INSERT assistant 完整消息
        R-->>C: data: [DONE]
    else 流中途失败
        R-->>C: data: {"error": "..."} → data: [DONE]
        Note over R,D: 已产生的文字不落库
    end
